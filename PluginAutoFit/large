```cpp
void push_backNewAxis(RdvCache& cache, float3 axis, float voteWeight = 1.0f) {
    if (cache.count < CACHE_SIZE) {
        // Nog ruimte: voeg toe aan einde
        int pos = cache.count;
        cache.entries[pos].axis = axis;
        cache.entries[pos].voteWeight = voteWeight;
        cache.count++;
        cache.writePos = cache.count;  // update writePos
    } else {
        // Cache vol: FIFO evictie
        int pos = cache.writePos;
        cache.entries[pos].axis = axis;
        cache.entries[pos].voteWeight = voteWeight;
        cache.writePos = (cache.writePos + 1) % CACHE_SIZE;
        
        // Bubble-up mogelijk nodig als voteWeight > voorganger
        // Maar startgewicht=1.0, dus waarschijnlijk niet
    }
}
```

