        float3 evictRadial = ring->entries[ring->writePos];
        float weight;
        tryMatchAndNudgeMainCacheReverse(evictRadial, &weight);
        
        // Overschrijf met nieuwe
        ring->entries[ring->writePos] = axis;
        ring->writePos = (ring->writePos + 1) % RING_SIZE;
