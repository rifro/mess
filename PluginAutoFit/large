__device__ void bubbleUpIfNeeded(RdvCacheAoS* cache, int idx) {
    while (idx > 0 && cache->entries[idx].voteWeight > cache->entries[idx-1].voteWeight) {
        CacheEntry temp = cache->entries[idx];
        cache->entries[idx] = cache->entries[idx-1];
