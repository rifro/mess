__device__ float3 computeNormal(Point center, Point* points, int idx, int totalPoints) {
    float3 p_center = center.pos;
    int farCount = 0;
    int ringCount = 0;
    float3 ring[4];
    
    // Zoek buren (vereenvoudigd - geen shared memory)
    for (int j = idx + 1; j < min(idx + 100, totalPoints); j++) {
        float3 neighbor = points[j].pos;
        float distSq = lengthSq(neighbor - p_center);
        
        if (distSq <= R2_SQ) {
            if (distSq > R1_SQ && ringCount < 4) {
                ring[ringCount++] = neighbor;
            }
        } else {
            farCount++;
            if (farCount >= 2) break;
