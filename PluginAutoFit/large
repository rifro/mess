## **3. PROCESSNORMALASRADIAL - COMPLETE LOGICA**

```cpp
__device__ void processNormalAsRadial(float3 radial, 
                                     RdvRingBuffer* myRing,
                                     RdvCache* sharedCache,
                                     int* sharedCacheCount) {
    // Skip invalid normals
    if (lengthSq(radial) < 1e-12f) return;
    
    // 1. Probeer te stemmen op bestaande cache (ORTHOGONALE matches)
    float bestWeight = MIN_VOTE_WEIGHT;
    int bestIdx = -1;
    
    for (int i = 0; i < *sharedCacheCount; i++) {
        float dot = fabsf(dot(radial, sharedCache->entries[i].axis));
        
        // Alleen orthogonale matches (hoek 75°-105°)
        if (dot < COS_75) {
            float sin_sq = 1.0f - dot * dot;  // sin²(θ)
            float weight = pow32(sin_sq);     // sin³²(θ) = (sin²)¹⁶
            
            if (weight > bestWeight) {
                bestWeight = weight;
                bestIdx = i;
            }
        }
    }
    
    // Stem als match gevonden
    if (bestIdx != -1) {
        atomicAdd(&sharedCache->entries[bestIdx].voteWeight, bestWeight);
        return;  // KLAAR
    }
    
    // 2. Geen stem: probeer cross met ringbuffer
    if (tryMakeCross(radial, myRing, sharedCache, sharedCacheCount)) {
        return;  // Cross gemaakt, radial verwerkt
    }
    
    // 3. Geen cross: voeg toe aan ringbuffer
    addToRingBuffer(radial, myRing, sharedCache, sharedCacheCount);
}
