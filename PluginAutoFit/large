#include "point_types.h" // Bevat de PointType::Elbow, PointType::Chaos, etc.

// Afstanden en Toleranties (Afkomstig uit de Configuration struct)
#define R1_SQ   0.000001f    // r1^2 (voor Duplicates)
#define R2_SQ   0.0016f      // r2^2 (maximale zoekradius)
#define EPS_SQ  1e-6f        // epsilon^2 voor planariteitstest
#define MIN_AREA_SQ 1e-12f   // Minimale oppervlakte voor niet-collineair

// Aangenomen: d_dot3, d_cross3, d_lengthSq, d_normalize zijn device helpers
// Aangenomen: getNeighborPoint(j) haalt point[j] op en checkt grens j < totalPoints

// --- Core Helper Functions ---

__device__ bool isCollinear(const float3& p1, const float3& p2, const float3& p3) {
    // Test of de oppervlakte van de driehoek te klein is (bijna ontaard).
    float3 side1 = p2 - p1;
    float3 side2 = p3 - p1;
    float3 normal_vector = d_cross3(side1, side2);
    
    // Controleer de lengte in het kwadraat van de normaal (deze is evenredig met oppervlakte^2)
    return d_lengthSq(normal_vector) < MIN_AREA_SQ;
}

/**
 * Controleert of de afstand van p_test tot het vlak gedefinieerd door (p1, p2, p3) slaagt.
 * Geeft de berekende normal (n_out) terug via een out-parameter als de planariteitstest slaagt.
 * * @param p1, p2, p3 Punten die het vlak definiëren.
 * @param p_test Het punt dat tot het vlak zou moeten behoren.
 * @param n_out Pointer naar de berekende normal bij succes.
 * @return true als de afstand tot het vlak binnen de tolerantie ligt.
 */
__device__ bool passesPlanarityTest(const float3& p1, const float3& p2, const float3& p3, const float3& p_test, float3* n_out) {
    // 1. Numerieke beveiliging: Faalt direct als de driehoek collineair is.
    if (isCollinear(p1, p2, p3)) {
        return false; 
    }
    
    // 2. Afstandstest: Bereken het vlak en de afstand tot p_test
    
    // Bereken de normal van het vlak
    float3 normal = d_normalize(d_cross3({p2.x - p1.x, p2.y - p1.y, p2.z - p1.z}, 
                                         {p3.x - p1.x, p3.y - p1.y, p3.z - p1.z}));
    
    // Vlakvergelijking: ax + by + cz = d
    float d = d_dot3(normal, p1);
    
    // Afstand van p_test tot het vlak: |normal * p_test - d|
    float distance = fabsf(d_dot3(normal, p_test) - d);
    float distance_sq = distance * distance;
    
    // Slaagt de planariteitstest?
    bool succeeded = distance_sq < EPS_SQ;

    if (succeeded && n_out) {
        *n_out = normal; // Geef de berekende normal terug
    }
    
    return succeeded;
}


// --- Hoofd Kernel Functie ---

__global__ void k_generate_normals(Point* points, const SizeT totalPoints, /* ...config... */) 
{
    // ... (thread en index setup) ...

    // q: Array om de gevonden ringpunten te verzamelen
    float3 q_ring[4]; 
    int ringCount = 0;
    
    // Pointers om de labels van buren aan te passen
    // Point* p_neighbor_labels[MAX_NEIGHBORS]; 
    int farPointCount = 0; // Teller voor punten buiten R2

    // --- 1. Ruisdetectie & Ringpuntenverzameling (Loop over buren) ---
    float3 p_center = {points[idx].x, points[idx].y, points[idx].z};
    
    // Start de sweep na de centrale index (idx + 1) tot het einde van de array (totalPoints)
    // Dit respecteert de Morton-volgorde en de array-grenzen.
    for (int j = idx + 1; j < totalPoints; ++j) {
        // Dure berekeningen: Alleen uitvoeren als de lus niet stopt
        float3 p_neighbor = getNeighborPoint(j); // Haal buurpunt op, nu gebaseerd op index j
        float distSq = d_lengthSq(p_neighbor - p_center);

        // Correctie: Test eerst op de buitenring (R2) voor efficiëntie
        if (distSq <= R2_SQ) {
            
            if (distSq <= R1_SQ) {
                // Ruis / Duplicaat: Binnen r1 (overschrijfbaar label)
                points[idx].label = PointType::Duplicate;
                // De buur zelf wordt ook als duplicaat gelabeld
            }
            else {
                // Ringpunt: Tussen r1 en r2
                if (ringCount < 4) {
                    q_ring[ringCount++] = p_neighbor;
                }
            }
        } else {
            // Punt ligt buiten R2
            farPointCount++;
             // HERSTELDE EARLY-OUT CHECK: Stop de zoektocht na de tweede bevestiging
			if (farPointCount >= 2) {
				break; 
			}
        }
    }


    // --- 2. Samenhangscontrole en Normalengeneratie ---
    // Initialiseer de final normal
    float3 n_final = {0.0f, 0.0f, 0.0f};

    // FINALE, GECOMBINEERDE TEST op samenhang 
    if (ringCount < 3 || farPointCount >= 2) {
        // GEEN SAMENHANG
        points[idx].label = PointType::Chaos; 
        // ... (Logica om de labels van buren binnen r2 aan te passen) ...
        
        return; // GEEN normal genereren
    }
    
    // --- 3. Robuuste Planariteitstest (ringCount >= 3) ---
    
    float3 p1 = q_ring[0]; 
    float3 p2 = q_ring[1]; 
