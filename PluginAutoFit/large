```cpp
// Shared nudging functie voor forward en reverse
__device__ void nudgeAndUpdateCacheEntry(CacheEntry& entry, const float3& n_in, float weight) {
    // 1. Bereken alpha
    float alpha = 1.0f / (entry.voteWeight + 1.0f);
    
    // 2. Nudging (gewogen door fit-kwaliteit)
    float3 weighted_nudge = n_in * weight;  // Zelf-beveiligend filter
    entry.axis = normalize(
        (1.0f - alpha) * entry.axis + 
        alpha * weighted_nudge
    );
    
    // 3. Update voteWeight
    entry.voteWeight += weight;
}

// Gebruik in beide functies:
__device__ bool tryMatchAndNudgeMainCacheForward(float3 n_in, RdvCacheAoS* cache) {
    // ... vind beste match ...
    if (best_idx != -1) {
        nudgeAndUpdateCacheEntry(cache->entries[best_idx], n_in, best_weight);
        bubbleUpIfNeeded(cache, best_idx);
        return true;
    }
    return false;
}

__device__ bool tryMatchAndNudgeMainCacheReverse(float3 n_in, RdvCacheAoS* cache) {
    // ... vind beste match (met cutoff) ...
    if (best_idx != -1) {
        nudgeAndUpdateCacheEntry(cache->entries[best_idx], n_in, best_weight);
        bubbleUpIfNeeded(cache, best_idx);
        return true;
    }
    return false;
}
