RdvCache combineResults(RdvCache* results, int numResults) {
    RdvCache final;
    final.count = 0;
    
    for (int i = 0; i < numResults; i++) {
        for (int j = 0; j < results[i].count; j++) {
            // Zoek beste match in final
            float bestDot = -1.0f;
            int bestIdx = -1;
            
            for (int k = 0; k < final.count; k++) {
                float dot = fabsf(dot(results[i].entries[j].axis, 
                                     final.entries[k].axis));
                if (dot > bestDot) {
                    bestDot = dot;
                    bestIdx = k;
                }
            }
            
            if (bestDot > 0.9f && bestIdx != -1) {  // Binnen ~25°
                // Merge
                final.entries[bestIdx].voteWeight += 
                    results[i].entries[j].voteWeight;
            } else if (final.count < CACHE_SIZE) {
                // Toevoegen
                final.entries[final.count] = results[i].entries[j];
                final.count++;
            }
        }
    }
    
    return final;
}
