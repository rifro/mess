## **9. HOST CODE - LAUNCH CONFIG**

```cpp
// Host code
void processAllPoints(Point* d_points, int numPoints) {
    // Bepaal chunk grootte
    int chunkSize = 16384;  // 16K punten per chunk
    int numChunks = (numPoints + chunkSize - 1) / chunkSize;
    
    // Alloceer resultaten
    RdvCache* d_results;
    cudaMalloc(&d_results, numChunks * sizeof(RdvCache));
    
    // Kernel config
    dim3 blockDim(256);
    dim3 gridDim((chunkSize + blockDim.x - 1) / blockDim.x);
    
    // Process elk chunk
    for (int chunk = 0; chunk < numChunks; chunk++) {
        int startIdx = chunk * chunkSize;
        int currentChunkSize = min(chunkSize, numPoints - startIdx);
        
        processPointsKernel<<<gridDim, blockDim>>>(
            d_points + startIdx, currentChunkSize, d_results, chunk
        );
        cudaDeviceSynchronize();
    }
    
    // Reduceer resultaten op host
    RdvCache* hostResults = new RdvCache[numChunks];
    cudaMemcpy(hostResults, d_results, numChunks * sizeof(RdvCache), 
               cudaMemcpyDeviceToHost);
    
    // Combineer resultaten
    RdvCache finalResult = combineResults(hostResults, numChunks);
    
    // Cleanup
    delete[] hostResults;
    cudaFree(d_results);
}
