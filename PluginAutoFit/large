## **1. PRODUCER: `k_generate_normals.cu`**

### **Core Logica:**
```cpp
__device__ bool passesPlanarityTest(const float3& p1, const float3& p2, 
                                   const float3& p3, const float3& pMatch, 
                                   float3* out_normal) {
    // 1. Eerst collineariteitscheck
    if (isCollinear(p1, p2, p3)) return false;
    
    // 2. Bereken vlaknormaal
    float3 normal = normalize(cross(p2 - p1, p3 - p1));
    
    // 3. Afstandstest tot vlak
    float d = dot(normal, p1);
    float distance = fabsf(dot(normal, pMatch) - d);
    bool success = (distance * distance) < EPS_SQ;
    
    if (success && out_normal) *out_normal = normal;
    return success;
}

// In kernel:
