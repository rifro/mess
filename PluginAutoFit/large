__device__ void inkomendeRadiaal(float3 nieuwe_radiaal) {
    // Buffer vol check
    bool buffer_vol = (ringCount == 8);
    
    if (!buffer_vol) {
        // Gewoon toevoegen
        Ring[posNext] = nieuwe_radiaal;
        ringCount++;
        posNext = (posNext + 1) & 7;
        return;
    }
    
    // ★★★ GEEN OPNEUW STEMMEN OP CACHE ★★★
    // Oude radiaal heeft dit AL geprobeerd toen hij binnenkwam
    // En gefaald (anders was hij niet in de buffer beland)
    
    int pos_te_overschrijven = posNext;
    float3 oude_radiaal = Ring[pos_te_overschrijven];
    
    // ★★★ ENIGE OPTIE: Probeer kruisproduct met NIEUWE radiaal ★★★
    float beste_gewicht = 0.0f;
    float3 beste_buis_as = {0,0,0};
    
    // Test oude_radiaal tegen nieuwe_radiaal
    float cos_hoek = fabsf(dot(oude_radiaal, nieuwe_radiaal));
    
    if (cos_hoek < COS_75) {  // Hoek ≥ 75°
        // Potentieel kruisproduct
        float3 kruis = normalize(cross(oude_radiaal, nieuwe_radiaal));
        
        // Beide moeten ~loodrecht op kruis staan
        float gewicht_oud = berekenBuisGewicht(oude_radiaal, kruis);
        float gewicht_nieuw = berekenBuisGewicht(nieuwe_radiaal, kruis);
        
        if (gewicht_oud > MIN_DRUMPEL && gewicht_nieuw > MIN_DRUMPEL) {
            beste_gewicht = (gewicht_oud + gewicht_nieuw) * 0.5f;
            beste_buis_as = kruis;
        }
    }
    
    // Als nog steeds geen match: test met andere radialen in buffer
    if (beste_gewicht == 0.0f) {
        for (int i = 0; i < 8; i++) {
            if (i == pos_te_overschrijven) continue;
            
            float3 andere_radiaal = Ring[i];
            cos_hoek = fabsf(dot(oude_radiaal, andere_radiaal));
            
            if (cos_hoek < COS_75) {
                float3 kruis = normalize(cross(oude_radiaal, andere_radiaal));
                
                float gewicht_oud = berekenBuisGewicht(oude_radiaal, kruis);
                float gewicht_andere = berekenBuisGewicht(andere_radiaal, kruis);
                
                if (gewicht_oud > MIN_DRUMPEL && gewicht_andere > MIN_DRUMPEL) {
                    float totaal_gewicht = (gewicht_oud + gewicht_andere) * 0.5f;
                    
                    if (totaal_gewicht > beste_gewicht) {
                        beste_gewicht = totaal_gewicht;
                        beste_buis_as = kruis;
                    }
                }
            }
        }
    }
    
    // Injectie indien geldig kruisproduct gevonden
    if (beste_gewicht > T_VALIDATIE) {
        injecteerInCache(beste_buis_as, beste_gewicht);
        
        // Buffer clearing - start opnieuw
        ringCount = 0;
        posNext = 0;
        Ring[0] = nieuwe_radiaal;
        ringCount = 1;
        posNext = 1;
        return;
    }
    
    // ★★★ GEEN MATCH: doe O(1) sweep met huidige buffer ★★★
    // (Zonder de oude radiaal - die wordt toch overschreven)
    
    // Hier de bestaande O(1) sweep logica met vaste offsets
    // ...
    
    // Tenslotte overschrijven
    Ring[posNext] = nieuwe_radiaal;
    posNext = (posNext + 1) & 7;
}
```

