/**
 * @brief Berekent (cos(x))^32 door herhaalde vermenigvuldiging (5 stappen).
 * @param cos_val De cosinus van de hoek (resultaat van dot product).
 * @return cos(x)^32
 */
__device__ float cos32_pow(float cos_val) {
    // 32 = 2^5. Vereist 5 vermenigvuldigingen: x -> x^2 -> x^4 -> x^8 -> x^16 -> x^32
    float x = cos_val * cos_val; // x^2
    x = x * x; // x^4
    x = x * x; // x^8
    x = x * x; // x^16
    x = x * x; // x^32
    return x;
}

/**
 * @brief Berekent (sin(x))^32 met behulp van de cos(90-x) identiteit.
 * @param angle_rad De hoek in radialen.
 * @return sin(x)^32
 */
__device__ float sin32_pow(float angle_rad) {
    // Gebruik de identiteit sin(x) = cos(90 - x)
    // De hoek 90 graden is PI/2 radialen (ongeveer 1.57079632679f)
    const float PI_HALF = 1.57079632679f; 
    
    // Bereken de cosinus van de complementaire hoek
    float complementary_angle = PI_HALF - angle_rad;
    
    // Bereken cos(complementary_angle)
    float cos_val = cosf(complementary_angle);
    
    // Gebruik de geoptimaliseerde cos32_pow functie
    return cos32_pow(cos_val);
}

