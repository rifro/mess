__device__ void addToRingBuffer(float3 radial, RdvRingBuffer* ring,
                               RdvCache* cache, int* cacheCount) {
    if (ring->full) {
        // ★★★ Evict oudste en geef laatste kans ★★★
        float3 evictRadial = ring->entries[ring->count];
        
        // Probeer te stemmen via reverse search
        tryReverseVote(evictRadial, cache, cacheCount);
        
        // Overschrijf oudste
        ring->entries[ring->count] = radial;
        ring->count = (ring->count + 1) & (RING_SIZE - 1);  // % 8
    } else {
        // Voeg toe
        ring->entries[ring->count] = radial;
        ring->count++;
        if (ring->count == RING_SIZE) {
            ring->full = true;
            ring->count = 0;  // Bij full=true wijst count naar oudste
        }
    }
}
