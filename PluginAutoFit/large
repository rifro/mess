float cos32_pow(float cosSq) {
    // (cos²)^16 = ((cos²)²)⁸ = ... 5 vermenigvuldigingen
    float x = cosSq * cosSq;   // cos⁴
    x = x * x;                 // cos⁸
    x = x * x;                 // cos¹⁶
    x = x * x;                 // cos³²
    return x;
}
```

