## **2. GPU KERNEL - COMPLETE IMPLEMENTATIE**

```cpp
__global__ void processPointsKernel(Point* points, int numPoints, 
                                   RdvCache* globalResults, int chunkId) {
    // Per-block shared cache
    __shared__ RdvCache s_cache;
    __shared__ int s_cacheCount;
    
    // Per-thread ringbuffer (in registers)
    RdvRingBuffer myRing;
    myRing.count = 0;
    myRing.full = false;
    
    // Init shared cache (thread 0)
    if (threadIdx.x == 0) {
        s_cache.count = 3;
        s_cache.entries[0] = {make_float3(1,0,0), 1.0f};
        s_cache.entries[1] = {make_float3(0,1,0), 1.0f};
        s_cache.entries[2] = {make_float3(0,0,1), 1.0f};
        s_cacheCount = 3;
    }
    __syncthreads();
    
    // Elke thread verwerkt zijn eigen punten
    int tid = threadIdx.x + blockIdx.x * blockDim.x;
    int stride = gridDim.x * blockDim.x;
    
    for (int idx = tid; idx < numPoints; idx += stride) {
        // 1. Producer: bereken normal
        float3 normal = computeNormal(points[idx], /* context */);
        
        // 2. Verwerk normal (ALTIJD als radiaal)
        processNormalAsRadial(normal, &myRing, &s_cache, &s_cacheCount);
    }
    
    // Synchroniseer na verwerking
    __syncthreads();
    
    // Thread 0: schrijf resultaat
    if (threadIdx.x == 0) {
        // Sorteer op voteWeight (bubble sort)
        for (int i = 0; i < s_cacheCount-1; i++) {
            for (int j = 0; j < s_cacheCount-i-1; j++) {
                if (s_cache.entries[j].voteWeight < s_cache.entries[j+1].voteWeight) {
                    CacheEntry temp = s_cache.entries[j];
                    s_cache.entries[j] = s_cache.entries[j+1];
                    s_cache.entries[j+1] = temp;
                }
            }
        }
        
        // Kopieer naar global memory
        globalResults[chunkId] = s_cache;
    }
}
