    for (int i = tid; i < RING_SIZE; i += blockDim.x * gridDim.x) {
        ringBuf->radialen[i] = make_float3(0.0f, 0.0f, 0.0f);
    }
    
    __syncthreads();
    
    // Alleen thread 0 zet de counters
    if (tid == 0) {
        cache->count = 0;
        ringBuf->count = 0;
        ringBuf->posNext = 0;
    }
    
    __syncthreads();
}
