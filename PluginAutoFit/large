## **2. CACHE MANAGEMENT**

### **Structuur & Invariant:**
```cpp
struct RdvCache {
    float3 axes[CACHE_SIZE];      // Richtingen (assen)
    float voteWeights[CACHE_SIZE]; // Cumulatief stemgewicht (float)
};

// INVARIANT: Cache is descending gesorteerd op voteWeight
// Nieuwe entries: voteWeight = 1.0f, altijd aan het einde
```

### **Injectie & Bubbleswap:**
```cpp
__device__ void injectNewAxis(RdvCache* cache, float3 new_axis) {
    // Altijd injecteren op laatste positie
    int inject_idx = min(cache_count, CACHE_SIZE-1);
    
    cache->axes[inject_idx] = normalize(new_axis);
    cache->voteWeights[inject_idx] = 1.0f;  // Startgewicht
    
    if (cache_count < CACHE_SIZE) cache_count++;
    
    // GEEN bubbleswap nodig - startgewicht is minimaal
}

__device__ void bubbleUpIfNeeded(RdvCache* cache, int idx) {
    // Alleen na stemmen: idx heeft net voteWeight verhoogd
    while (idx > 0 && cache->voteWeights[idx] > cache->voteWeights[idx-1]) {
        swap(cache->axes[idx], cache->axes[idx-1]);
        swap(cache->voteWeights[idx], cache->voteWeights[idx-1]);
        idx--;
    }
}
```

## **3. VOTER FUNCTIES**

### **3.1 `tryMatchAndNudgeMainCacheForward`**
```cpp
__device__ bool tryMatchAndNudgeMainCacheForward(float3 n_in, RdvCache* cache) {
    float best_weight = MIN_NUDGE_THRESHOLD;
    int best_idx = -1;
    
    for (int i = 0; i < cache_count; i++) {
        float cos_theta = dot(n_in, cache->axes[i]);
        float abs_cos = fabsf(cos_theta);
        
        // Cutoff checks:
        // Vlakburst: hoek ≈ 0° (|cos| > cos15)
        // Buis: hoek ≈ 90° (|cos| < cos75)
        
        // Bereken gewichten
        float w_flat = cos32_pow(abs_cos);
        float w_tube = sin32_pow(acosf(abs_cos));
        float w_final = fmaxf(w_flat, w_tube);
        
        if (w_final > best_weight) {
            best_weight = w_final;
            best_idx = i;
        }
    }
    
    if (best_idx == -1) return false;
    
    // Nudging
    float alpha = 1.0f / (cache->voteWeights[best_idx] + 1.0f);
    cache->axes[best_idx] = normalize(
        (1.0f - alpha) * cache->axes[best_idx] + 
        alpha * n_in * best_weight  // Gewogen door fit
    );
    
    // Update voteWeight en bubbleswap
    cache->voteWeights[best_idx] += best_weight;
    bubbleUpIfNeeded(cache, best_idx);
    
    return true;
}
```

### **3.2 `tryMatchAndNudgeMainCacheReverse`**
```cpp
__device__ bool tryMatchAndNudgeMainCacheReverse(float3 n_in, RdvCache* cache) {
    float best_weight = MIN_NUDGE_THRESHOLD;
    int best_idx = -1;
    
    // Scan achterstevoren, stop bij voteWeight > 15.0f
    for (int i = cache_count-1; i >= 0; i--) {
        if (cache->voteWeights[i] > 15.0f) break;
        
        // ...zelfde gewichtsberekening als Forward...
        // Als match gevonden: best_idx = i
    }
    
    if (best_idx == -1) return false;
    
    // Zelfde nudging en update als Forward
    // ...
    return true;
}
```

## **4. RINGBUFFER: `bestCrossWithBuffer`**

```cpp
__device__ bool bestCrossWithBuffer(float3 failedVoteRadial) {
    // a) Probeer direct cross met buffer elementen
    if (ringCount > 0) {
        float beste_hoek = 0.0f;
        int beste_idx = -1;
        
        // Volledige scan voor beste ~90° match
        for (int i = 0; i < ringCount; i++) {
            float cos_hoek = fabsf(dot(failedVoteRadial, Ring[i]));
            if (cos_hoek < COS_70) {  // > 70°
                float hoek = acosf(cos_hoek);
                if (fabsf(hoek - 1.5708f) < fabsf(beste_hoek - 1.5708f)) {
                    beste_hoek = hoek;
                    beste_idx = i;
                }
            }
        }
        
        if (beste_idx != -1) {
            float3 cross = normalize(cross(failedVoteRadial, Ring[beste_idx]));
            injectNewAxis(cache, cross);
            return true;  // Cross geïnjecteerd
        }
    }
    
    // b) Buffer nog niet vol? Voeg toe
    if (ringCount < 8) {
        Ring[posNext] = failedVoteRadial;
        ringCount++;
        posNext = (posNext + 1) & 7;
        return false;
    }
    
    // c) Buffer vol: evict-radiaal krijgt laatste kans
    int evict_pos = posNext;
    float3 evict_radial = Ring[evict_pos];
    
    // Probeer reverse matching voor evict-radiaal
    if (tryMatchAndNudgeMainCacheReverse(evict_radial, cache)) {
        // Succes! evict-radiaal heeft alsnog gestemd
        // Buffer reset voor nieuwe start
        ringCount = 0;
        posNext = 0;
        Ring[0] = failedVoteRadial;
        ringCount = 1;
        posNext = 1;
        return true;
    }
    
    // d) Geen succes: overschrijf en return false
    Ring[posNext] = failedVoteRadial;
    posNext = (posNext + 1) & 7;
    return false;
}
```

