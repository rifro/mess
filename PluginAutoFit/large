## **3. BestCrossWithBuffer - Gecorrigeerde Logica**

```cpp
__device__ bool bestCrossWithBuffer(float3 failedVoteRadial, 
                                   RingBuffer* ringBuf,
                                   RdvCache* cache) {
    // a) Probeer cross met buffer elementen (als die er zijn)
    if (ringBuf->ringCount > 0) {
        float beste_dot = 1.0f;  // Minimaal zoeken: dot = cos(θ)
        int beste_idx = -1;
        
        for (int i = 0; i < ringBuf->ringCount; i++) {
            float dot_val = fabsf(dot(failedVoteRadial, ringBuf->radialen[i]));
            if (dot_val < beste_dot) {
                beste_dot = dot_val;
                beste_idx = i;
            }
        }
        
        // Controleren of de beste hoek ≥ 70° is
        if (beste_dot < COS_70) {  // cos(70°) = 0.342
            // Cross is geldig!
            float3 cross_as = normalize(cross(failedVoteRadial, ringBuf->radialen[beste_idx]));
            
            // 1. Injecteer cross in cache
            injectNewAxis(cache, cross_as);
            
            // 2. Laat failedVoteRadial stemmen op deze nieuwe cross
            //    Dit zal gegarandeerd slagen omdat ze loodrecht staan
            float weight;
            bool success = tryMatchAndNudgeMainCacheReverse(failedVoteRadial, cache, weight);
            
            // 3. Reset ringbuffer (begin opnieuw)
            ringBuf->ringCount = 0;
            ringBuf->posNext = 0;
            
            // 4. FAILEDVOTERADIAL IS VERWERKT, GAAT NIET NAAR BUFFER
            return true;  // Cross gemaakt en gestemd
        }
    }
    
    // b) Geen geldige cross: voeg toe aan ringbuffer
    if (ringBuf->ringCount < 8) {
        ringBuf->radialen[ringBuf->posNext] = failedVoteRadial;
        ringBuf->ringCount++;
        ringBuf->posNext = (ringBuf->posNext + 1) & 7;
    }
    // c) Buffer vol: evict oudste EN geef die laatste kans
    else {
        // Geef evict-radiaal laatste kans
        float3 evictRadial = ringBuf->radialen[ringBuf->posNext];
        float weight;
        tryMatchAndNudgeMainCacheReverse(evictRadial, cache, weight);
        
        // Overschrijf nu met nieuwe radiaal
        ringBuf->radialen[ringBuf->posNext] = failedVoteRadial;
        ringBuf->posNext = (ringBuf->posNext + 1) & 7;
        // ringCount blijft 8
    }
    
    return false;  // Geen cross gemaakt
}
```

## **4. TryMatchAndNudgeMainCacheReverse MET cacheCount**

```cpp
__device__ bool tryMatchAndNudgeMainCacheReverse(float3 n_in, 
                                                RdvCache* cache,
                                                float& out_weight) {
    float best_weight = MIN_NUDGE_THRESHOLD;
    int best_idx = -1;
    
    // Reverse scan met cutoff
    for (int i = cache->cacheCount - 1; i >= 0; i--) {
        // ★★★ STOP bij sterke entries ★★★
        if (cache->entries[i].voteWeight > VOTE_WEIGHT_CUTOFF) break;
        
        float cos_theta = dot(n_in, cache->entries[i].axis);
        float abs_cos = fabsf(cos_theta);
        
        // Cutoffs: alleen controleren als binnen acceptabele ranges
        if (abs_cos > COS_15 || abs_cos < COS_75) {
            float w_final = fmaxf(cos32_pow(abs_cos), sin32_pow(acosf(abs_cos)));
            
            if (w_final > best_weight) {
                best_weight = w_final;
                best_idx = i;
            }
        }
    }
    
    if (best_idx == -1) return false;
    
    // Nudging en update
    nudgeAndUpdateEntry(cache->entries[best_idx], n_in, best_weight);
    bubbleUpIfNeeded(cache, best_idx);
    
    out_weight = best_weight;
    return true;
}
```

