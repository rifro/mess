## **4. CROSS LOGICA**

```cpp
__device__ bool tryMakeCross(float3 radial, RdvRingBuffer* ring,
                            RdvCache* cache, int* cacheCount) {
    // Buffer moet radialen bevatten
    if (ring->count == 0 && !ring->full) return false;
    
    // Zoek beste partner (~90°)
    float bestDot = 1.0f;
    int bestIdx = -1;
    int limit = ring->full ? RING_SIZE : ring->count;
    
    for (int i = 0; i < limit; i++) {
        float dot = fabsf(dot(radial, ring->entries[i]));
        if (dot < bestDot) {
            bestDot = dot;
            bestIdx = i;
        }
    }
    
    // Check of hoek ≥ 70°
    if (bestDot < COS_70) {
        // Maak cross
        float3 cross = normalize(cross(radial, ring->entries[bestIdx]));
        
        // Bereken stemgewicht
        float sin_sq = 1.0f - bestDot * bestDot;
        float weight = pow32(sin_sq);  // sin³²(θ)
        
        // Voeg toe aan cache (atomic)
        int newIdx = atomicAdd(cacheCount, 1);
        if (newIdx < CACHE_SIZE) {
            cache->entries[newIdx].axis = cross;
            cache->entries[newIdx].voteWeight = weight;
        } else {
            atomicSub(cacheCount, 1);  // Cache vol
        }
        
        // Laat radial stemmen op deze nieuwe cross
        // Cross staat op index newIdx (of laatste positie)
        float dot_cross = fabsf(dot(radial, cross));
        if (dot_cross < COS_75) {
            float voteWeight = pow32(1.0f - dot_cross * dot_cross);
            atomicAdd(&cache->entries[newIdx].voteWeight, voteWeight);
        }
        
        return true;
    }
    
    return false;
}
```

