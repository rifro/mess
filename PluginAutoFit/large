__device__ float cos32_pow(float cosSq) {
    float x = cosSq;  // cos²
    x = x * x;        // cos⁴
    x = x * x;        // cos⁸
    x = x * x;        // cos¹⁶
    x = x * x;        // cos³²
    return x;
