__device__ float3 computeNormalFromNeighbours(Point* s_points, int centerIdx) {
    float3 center = s_points[centerIdx].pos;
    int ringCount = 0;
    float3 candidates[4];
    
    // Zoek buren binnen R2 (snel in shared memory)
    for (int offset = 1; offset <= 32; offset++) {
        Point p = s_points[centerIdx + offset];
        float distSq = lengthSq(p.pos - center);
        
        if (distSq <= R2_SQ && distSq > R1_SQ) {
            if (ringCount < 4) {
                candidates[ringCount++] = p.pos;
            }
        }
        
        // Early-out bij 2× far points
        if (distSq > R2_SQ) {
            // ... far point tracking
        }
    }
    
    // Planariteitstest (driehoekjes)
    if (ringCount >= 3) {
        float3 normal;
        if (testTriangle(center, candidates[0], candidates[1], candidates[2], normal)) {
            return normal;
        }
    }
    
    // Geen normal gevonden → chaos point
    s_points[centerIdx].label = PointType::Chaos;
    return make_float3(0,0,0);
