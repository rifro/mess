// FIX 3: Nudging toevoegen
__device__ void nudgeAxis(CacheEntry& entry, float3 normal, float dot, bool isPlane) {
    float alpha = 1.0f / (entry.voteWeight + 1.0f);
    
    if (isPlane) {
        // Vlak: nudge naar normal (parallel)
        entry.axis = normalize(entry.axis * (1.0f - alpha) + normal * alpha);
    } else {
        // Buis: nudge naar orthogonale component
        // Project normal loodrecht op entry.axis
        float3 ortho = normal - entry.axis * dot;
        if (length(ortho) > 1e-6f) {
            ortho = normalize(ortho);
            entry.axis = normalize(entry.axis * (1.0f - alpha) + ortho * alpha);
        }
    }
    
    entry.voteWeight += (isPlane ? cos32_pow(dot*dot) : cos32_pow(1.0f - dot*dot));
}
