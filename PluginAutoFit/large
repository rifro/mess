__device__ bool bestCrossWithBuffer(float3 radial, RingBuffer* ring, RdvCache* cache) {
    float bestDot = 1.0f;
    int bestIdx = -1;
    
    // Zoek beste partner
    for (int i = 0; i < ring->count; i++) {
        float dot = fabsf(dot(radial, ring->entries[i]));
        if (dot < bestDot) {
            bestDot = dot;
            bestIdx = i;
        }
    }
    
    // Check of hoek ≥ 70° (|dot| < cos70)
    if (bestIdx != -1 && bestDot < COS_70) {
        // Maak cross
        float3 cross = normalize(cross(radial, ring->entries[bestIdx]));
        
        // Bereken stemgewicht (sin³²(θ) = cos³²(1.0f - dot²))
        float weight = cos32_pow(1.0f - bestDot * bestDot);
        
        // Injecteer cross met startgewicht = weight (radiaal heeft al gestemd)
        push_backNewAxis(cache, cross, weight);
        
        // GEEN verdere stemming nodig, radiaal is verwerkt
        return true;
    }
    
    return false;
}
