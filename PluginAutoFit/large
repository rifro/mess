### **4. Gedeelde Cache met Atomic Updates**

```cpp
struct RdvCache {
    CacheEntry entries[16];  // Fixed size
    // count wordt apart bijgehouden in sharedCacheCount
};

__device__ void processNormalPerThread(float3 normal, bool planeBurst,
                                      RdvRingBuffer* myRing,
                                      RdvCache* sharedCache,
                                      int* sharedCacheCount) {
    // 1. Probeer te stemmen op shared cache
    float bestWeight = 0.0f;
    int bestIdx = -1;
    bool isPlaneMatch = false;
    
    // Zoek beste match in cache (forward scan)
    for (int i = 0; i < *sharedCacheCount; i++) {
        float dot = dot(normal, sharedCache->entries[i].axis);
        float absDot = fabsf(dot);
        
        if (planeBurst) {
            // Vlak modus: zoek parallelle as
            if (absDot > COS_15) {
                float weight = cos32_pow(dot*dot);
                if (weight > bestWeight) {
                    bestWeight = weight;
                    bestIdx = i;
                    isPlaneMatch = true;
                }
            }
        } else {
            // Buis modus: zoek orthogonale as
            if (absDot < COS_75) {
                float weight = cos32_pow(1.0f - dot*dot);
                if (weight > bestWeight) {
                    bestWeight = weight;
                    bestIdx = i;
                    isPlaneMatch = false;
                }
            }
        }
    }
    
    // 2. Als match gevonden: atomic update
    if (bestIdx != -1) {
        atomicAdd(&sharedCache->entries[bestIdx].voteWeight, bestWeight);
        
        // Nudging: we doen dit NIET tijdens verwerking
        // We accumuleren alleen voteWeight
        return;
    }
    
    // 3. Geen match: probeer cross met eigen ringbuffer
    if (tryCrossWithMyRing(normal, myRing, sharedCache, sharedCacheCount)) {
        return;
    }
    
    // 4. Geen cross: voeg toe aan eigen ringbuffer
    ringBufferAdd(myRing, normal);
}
```

### **5. Cross maken met Eigen Ringbuffer**

```cpp
__device__ bool tryCrossWithMyRing(float3 radial, RdvRingBuffer* myRing,
                                  RdvCache* sharedCache, int* sharedCacheCount) {
    if (myRing->count == 0) return false;
    
    // Zoek beste partner in ringbuffer
    float bestDot = 1.0f;
    int bestIdx = -1;
    
    for (int i = 0; i < (myRing->full ? 8 : myRing->count); i++) {
        float dot = fabsf(dot(radial, myRing->entries[i]));
        if (dot < bestDot) {
            bestDot = dot;
            bestIdx = i;
        }
    }
    
    // Check of hoek ≥ 70°
    if (bestDot < COS_70) {
        // Maak cross
        float3 cross = normalize(cross(radial, myRing->entries[bestIdx]));
        
        // Bereken stemgewicht
        float weight = cos32_pow(1.0f - bestDot*bestDot);
        
        // Voeg toe aan shared cache (atomic)
        int newIdx = atomicAdd(sharedCacheCount, 1);
        if (newIdx < 16) {
            sharedCache->entries[newIdx].axis = cross;
            sharedCache->entries[newIdx].voteWeight = weight;
        } else {
            // Cache vol - evict laagste (later)
            atomicSub(sharedCacheCount, 1);
        }
        
        return true;
    }
    
    return false;
}
```

