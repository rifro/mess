## **4. PROCESSNORMALPARALLEL - EINDVERSIE**

```cpp
__device__ void processNormalParallel(float3 normal, 
                                     RdvRingBuffer* myRing,
                                     RdvCache* sharedCache,
                                     int* sharedCacheCount) {
    // Skip chaos/geen-normal
    if (lengthSq(normal) < 1e-12f) return;
    
    // 1. Probeer te stemmen op shared cache (alleen orthogonale matches)
    float bestWeight = 0.0f;
    int bestIdx = -1;
    
    for (int i = 0; i < *sharedCacheCount; i++) {
        float dot = fabsf(dot(normal, sharedCache->entries[i].axis));
        
        // Alleen orthogonale matches (hoek 75°-105°)
        if (dot < COS_75) {
            // sin²(θ) = 1 - dot², sin³²(θ) = (sin²)¹⁶
            float sin_sq = 1.0f - dot * dot;
            float weight = pow32(sin_sq);  // sin³²(θ)
            
            if (weight > bestWeight && weight > MIN_STEM_THRESHOLD) {
                bestWeight = weight;
                bestIdx = i;
            }
        }
    }
    
    if (bestIdx != -1) {
        // ATOMIC update van voteWeight
        atomicAdd(&sharedCache->entries[bestIdx].voteWeight, bestWeight);
        
        // Nudging doen we later (post-processing)
        return;
    }
    
    // 2. Geen stem: probeer cross met eigen ringbuffer
    if (tryCrossWithMyRing(normal, myRing, sharedCache, sharedCacheCount)) {
        return;
    }
    
    // 3. Geen cross: voeg toe aan eigen ringbuffer
    ringBufferAdd(myRing, normal, sharedCache, sharedCacheCount);
}
```

## **5. RINGBUFFER MET EVICTIE (jouw ontwerp)**

```cpp
__device__ void ringBufferAdd(RdvRingBuffer* ring, float3 radial,
                             RdvCache* sharedCache, int* sharedCacheCount) {
    if (ring->full) {
        // ★★★ EVICT oudste (op ring->count) en geef laatste kans ★★★
        float3 evictRadial = ring->entries[ring->count];
        
        // Probeer te stemmen via reverse search
        tryReverseVote(evictRadial, sharedCache, sharedCacheCount);
        
        // Overschrijf oudste
        ring->entries[ring->count] = radial;
        ring->count = (ring->count + 1) & 7;  // Mod 8
    } else {
        ring->entries[ring->count] = radial;
        ring->count++;
        if (ring->count == 8) {
            ring->full = true;
            ring->count = 0;  // Bij full=true, count wijst naar oudste
        }
    }
}

__device__ bool tryReverseVote(float3 radial, RdvCache* cache, int* cacheCount) {
    float bestWeight = 0.0f;
    int bestIdx = -1;
    
    // Reverse search met voteWeight cutoff
    for (int i = *cacheCount - 1; i >= 0; i--) {
        if (cache->entries[i].voteWeight > 15.0f) break;
        
        float dot = fabsf(dot(radial, cache->entries[i].axis));
        if (dot < COS_75) {
            float sin_sq = 1.0f - dot * dot;
            float weight = pow32(sin_sq);
            
            if (weight > bestWeight) {
                bestWeight = weight;
                bestIdx = i;
            }
        }
    }
    
    if (bestIdx != -1) {
        atomicAdd(&cache->entries[bestIdx].voteWeight, bestWeight);
        return true;
    }
    return false;
}
```

## **6. CROSS MAKEN MET RINGBUFFER**

```cpp
__device__ bool tryCrossWithMyRing(float3 radial, RdvRingBuffer* ring,
                                  RdvCache* sharedCache, int* sharedCacheCount) {
    if (ring->count == 0 && !ring->full) return false;
    
    // Zoek beste ~90° partner
    float bestDot = 1.0f;
    int bestIdx = -1;
    int limit = ring->full ? 8 : ring->count;
    
    for (int i = 0; i < limit; i++) {
        float dot = fabsf(dot(radial, ring->entries[i]));
        if (dot < bestDot) {
            bestDot = dot;
            bestIdx = i;
        }
    }
    
    // Check of hoek ≥ 70°
    if (bestDot < COS_70) {
        // Maak cross
        float3 cross = normalize(cross(radial, ring->entries[bestIdx]));
        
        // Bereken stemgewicht (sin³² van de hoek)
        float sin_sq = 1.0f - bestDot * bestDot;
        float weight = pow32(sin_sq);
        
        // Voeg toe aan shared cache (atomic)
        int newIdx = atomicAdd(sharedCacheCount, 1);
        if (newIdx < CACHE_SIZE) {
            sharedCache->entries[newIdx].axis = cross;
            sharedCache->entries[newIdx].voteWeight = weight;
            
            // Bubble-up niet nodig - nieuwe as heeft lage weight
        } else {
            atomicSub(sharedCacheCount, 1);  // Cache vol
        }
        
        return true;
    }
    
    return false;
}
```

