### **Optie 3: Device init kernel (Alle threads, maar atomic of cooperative)**
```cpp
__global__ void initKernelCooperative(RdvCache* cache, RingBuffer* ringBuf) {
    // Elke thread initialiseert een deel (parallel)
    int tid = threadIdx.x + blockIdx.x * blockDim.x;
    
    // Cache init - verdeel werk
    for (int i = tid; i < CACHE_SIZE; i += blockDim.x * gridDim.x) {
        cache->entries[i].axis = make_float3(0.0f, 0.0f, 0.0f);
        cache->entries[i].voteWeight = 0.0f;
    }
    
