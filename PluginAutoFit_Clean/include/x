#pragma once
#include "rdv_types.h"

namespace Bocari
{
    struct RingFilterConfig {
        float innerRadiusSq;   // Pre-calculated: r^2
        float outerRadiusSq;   // Pre-calculated: r^2
        float mortonJumpSq;    // Pre-calculated: r^2
        float minAreaSq;       // For collinearity check
        float planarEpsilon;   // Linear distance threshold
    };

    struct RdvVoterConfig {
        u32 ringBufferSize;    // Must be power of 2
        u32 ringBufferMask;    // Pre-calculated: size - 1
        u32 cacheSize;
        u32 initialVoteCount;
        float cosCutoff;
        float minNudgeThreshold;
    };

    struct RdvConfig {
        RingFilterConfig ringFilter;
        RdvVoterConfig rdvVoter;
        // ... other config sections
    };

} // namespace Bocari
